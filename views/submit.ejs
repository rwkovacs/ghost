<%- include('partials/header') %>
<h1>submit</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="post" action="/submit" class="cform">
  <label>ghost
    <select name="sub" required>
      <option value="">-- pick a ghost --</option>
      <% subs.forEach(s => { %>
        <option value="<%= s.name %>" <%= s.name === subName ? 'selected' : '' %>>g/<%= s.name %></option>
      <% }); %>
    </select>
  </label>
  <label>title <input type="text" name="title" maxlength="300" required></label>
  <label>link (optional) <input type="url" name="url" maxlength="2000" placeholder="https://..."></label>
  <label>body (optional) <textarea name="body" rows="8" maxlength="20000"></textarea></label>
  <%- include('partials/captcha') %>
  <button type="submit">submit anonymously</button>
</form>
<%- include('partials/footer') %>
