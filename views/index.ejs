<%- include('partials/header') %>
<div class="layout">
  <section class="feed">
    <h1>latest threads</h1>
    <% if (posts.length === 0) { %>
      <p class="muted">No threads yet. <a href="/submit">Start one.</a></p>
    <% } %>
    <% posts.forEach(p => { %>
      <article class="post-card <%= p.removed ? 'removed' : '' %>">
        <div class="score" title="score"><%= p.score >= 0 ? '+' : '' %><%= p.score %></div>
        <div class="meta">
          <a class="title" href="/g/<%= p.sub %>/<%= p.id %>"><%= p.removed ? '[removed]' : p.title %></a>
          <% if (p.url && !p.removed) { %>
            <a class="ext" href="<%= p.url %>" rel="nofollow noopener" target="_blank">[link]</a>
          <% } %>
          <div class="sub-line">
            <a href="/g/<%= p.sub %>">/g/<%= p.sub %>/</a>
            <span class="dot">·</span>
            <span class="flag" title="<%= p.country || 'unknown' %>"><%= p.country ? flagEmoji(p.country) + ' ' + p.country : '🏴 ??' %></span>
            <span class="dot">·</span>
            <span><%= new Date(p.created_at).toISOString().slice(0,16).replace('T',' ') %> UTC</span>
            <span class="dot">·</span>
            <a href="/g/<%= p.sub %>/<%= p.id %>"><%= p.comment_count %> replies</a>
          </div>
        </div>
      </article>
    <% }); %>
  </section>
  <aside>
    <div class="sidebar">
      <h2>boards</h2>
      <ul class="subs">
        <% subs.forEach(s => { %>
          <li><a href="/g/<%= s.name %>">/g/<%= s.name %>/</a></li>
        <% }); %>
      </ul>
    </div>
    <div class="sidebar">
      <h2>about</h2>
      <p class="muted" style="margin:.25rem 0">Anonymous text-board. No accounts. No tracking. Every poster gets a thread-unique ID.</p>
    </div>
    <div class="sidebar">
      <h2>rules</h2>
      <ol class="rules">
        <li>No CSAM, doxxing, or credible threats.</li>
        <li>No spam, no flooding, no off-topic crossposts.</li>
        <li>Stay on-board: post in the right /g/.</li>
        <li>Disagree freely — argue ideas, not identities.</li>
      </ol>
    </div>
  </aside>
</div>
<%- include('partials/footer') %>
