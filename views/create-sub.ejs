<%- include('partials/header') %>
<h1>create a ghost</h1>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<form method="post" action="/new-ghost" class="cform">
  <label>name (a-z, 0-9, _) <input type="text" name="name" maxlength="24" required pattern="[a-z0-9_]{2,24}"></label>
  <label>description <textarea name="description" maxlength="500" rows="3"></textarea></label>
  <%- include('partials/captcha') %>
  <button type="submit">create</button>
</form>
<%- include('partials/footer') %>
