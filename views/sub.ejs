<%- include('partials/header') %>
<div class="board-head">
  <h1>/g/<%= sub.name %>/</h1>
  <p class="desc"><%= sub.description || 'No description.' %></p>
  <div class="actions">
    <a class="btn btn-primary" href="/submit?sub=<%= sub.name %>">+ new thread</a>
    <a class="btn" href="/">← all boards</a>
  </div>
</div>

<% if (posts.length === 0) { %>
  <p class="muted">No threads on this board yet.</p>
<% } %>
<% posts.forEach(p => { %>
  <article class="post-card <%= p.removed ? 'removed' : '' %>">
    <div class="score" title="score"><%= p.score >= 0 ? '+' : '' %><%= p.score %></div>
    <div class="meta">
      <a class="title" href="/g/<%= p.sub %>/<%= p.id %>"><%= p.removed ? '[removed]' : p.title %></a>
      <% if (p.url && !p.removed) { %>
        <a class="ext" href="<%= p.url %>" rel="nofollow noopener" target="_blank">[link]</a>
      <% } %>
      <div class="sub-line">
        <span class="flag" title="<%= p.country || 'unknown' %>"><%= p.country ? flagEmoji(p.country) + ' ' + p.country : '🏴 ??' %></span>
        <span class="dot">·</span>
        <span><%= new Date(p.created_at).toISOString().slice(0,16).replace('T',' ') %> UTC</span>
        <span class="dot">·</span>
        <a href="/g/<%= p.sub %>/<%= p.id %>"><%= p.comment_count %> replies</a>
      </div>
    </div>
  </article>
<% }); %>
<%- include('partials/footer') %>
